<?xml version="1.0" encoding="utf-8"?>
    <androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/mainProfile"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#121212"
        android:fitsSystemWindows="true"
        tools:context=".ProfileActivity">

        <!-- 1. FIXED TOP HEADER -->
        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:fitsSystemWindows="true"
            app:elevation="0dp">

            <include
                android:id="@+id/topHeader"
                layout="@layout/layout_top_header"
                android:layout_width="match_parent"
                android:layout_height="64dp" />
        </com.google.android.material.appbar.AppBarLayout>

        <!-- 2. SCROLLABLE MIDDLE CONTENT -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            android:clipToPadding="false"
            android:paddingBottom="120dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center_horizontal">

                <!-- Profile Picture with Edit Badge -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgProfileAvatar"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_profile"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:shapeAppearanceOverlay="@style/CircleImageView"
                        app:strokeColor="#333333"
                        app:strokeWidth="2dp"/>

                    <!-- Edit Icon Badge -->
                    <ImageView
                        android:id="@+id/btnEditProfile"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/ic_pencil"
                        android:padding="6dp"
                        android:src="@android:drawable/ic_menu_edit"
                        app:tint="#121212"
                        app:layout_constraintBottom_toBottomOf="@id/imgProfileAvatar"
                        app:layout_constraintEnd_toEndOf="@id/imgProfileAvatar"
                        app:layout_constraintHorizontal_bias="0.95"
                        app:layout_constraintVertical_bias="0.95" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- User Info Text -->
                <TextView
                    android:id="@+id/txtUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Gcina Makhala"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <!-- Pill-shaped Status -->
                <TextView
                    android:id="@+id/txtUserStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="6dp"
                    android:text="Student Commuter - Gqeberha"
                    android:textColor="#A0A0A0"
                    android:fontFamily="monospace"
                    android:textSize="12sp" />

                <!-- MOBILITY PREFERENCES CARD -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    app:cardBackgroundColor="#1E1E1E"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="#333333"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Card Header -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_train"
                                app:tint="#00FFFF" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text="Mobility Preferences"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Saved Locations -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:letterSpacing="0.1"
                            android:text="SAVED LOCATIONS"
                            android:textColor="#888888"
                            android:fontFamily="monospace"
                            android:textSize="12sp" />

                        <!-- Location Chips -->
                        <com.google.android.material.chip.ChipGroup
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            app:chipSpacingHorizontal="8dp">

                            <com.google.android.material.chip.Chip
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="NM University"
                                android:textColor="#E0E0E0"
                                app:chipBackgroundColor="#2A2A2A"
                                app:chipIcon="@drawable/ic_university"
                                app:chipIconTint="#A0A0A0"
                                app:iconStartPadding="8dp" />

                            <com.google.android.material.chip.Chip
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Home"
                                android:textColor="#E0E0E0"
                                app:chipBackgroundColor="#2A2A2A"
                                app:chipIcon="@drawable/ic_home"
                                app:chipIconTint="#A0A0A0"
                                app:iconStartPadding="8dp" />

                            <com.google.android.material.chip.Chip
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Stadium"
                                android:textColor="#E0E0E0"
                                app:chipBackgroundColor="#2A2A2A"
                                app:chipIcon="@drawable/ic_stadium"
                                app:chipIconTint="#A0A0A0"
                                app:iconStartPadding="8dp" />
                        </com.google.android.material.chip.ChipGroup>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="20dp"
                            android:layout_marginBottom="20dp"
                            android:background="#333333" />

                        <!-- Active Pass -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:id="@+id/lblCommuterPass"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Active Commuter Passes"
                                android:textColor="#888888"
                                android:fontFamily="monospace"
                                android:textSize="12sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/lblCommuterPass"
                                android:layout_marginTop="4dp"
                                android:text="Algoa Bus Student Pass"
                                android:textColor="#E0E0E0"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:background="#1A00FF7F"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:text="ACTIVE"
                                android:textColor="#00FF7F"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </RelativeLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="20dp"
                            android:layout_marginBottom="20dp"
                            android:background="#333333" />

                        <!-- Telemetry Sharing Toggle -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:id="@+id/lblTelemetry"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Telemetry Sharing"
                                android:textColor="#888888"
                                android:fontFamily="monospace"
                                android:textSize="12sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/lblTelemetry"
                                android:layout_marginTop="4dp"
                                android:layout_toStartOf="@id/switchTelemetry"
                                android:layout_alignParentStart="true"
                                android:text="Optimize routes with real-time data"
                                android:textColor="#E0E0E0"
                                android:textSize="14sp" />

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/switchTelemetry"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:checked="true"
                                app:useMaterialThemeColors="false"
                                app:thumbTint="#00FFFF"
                                app:trackTint="#1A00FFFF"/>
                        </RelativeLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- WALLET & SECURITY CARD -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    app:cardBackgroundColor="#1E1E1E"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="#333333"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_wallet"
                                app:tint="#E0E0E0" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text="Wallet &amp; Security"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Payment Methods -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp">

                            <TextView
                                android:id="@+id/lblPayment"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Payment Methods"
                                android:textColor="#888888"
                                android:fontFamily="monospace"
                                android:textSize="12sp" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/lblPayment"
                                android:layout_marginTop="8dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="30dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/ic_card"
                                    app:tint="#00FFFF" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="Visa ending in ****4242"
                                    android:textColor="#E0E0E0"
                                    android:textSize="16sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/btnManagePayment"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:text="Manage"
                                android:textColor="#00FFFF"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:clickable="true"
                                android:focusable="true"/>
                        </RelativeLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="20dp"
                            android:layout_marginBottom="20dp"
                            android:background="#333333" />

                        <!-- Transaction History -->
                        <RelativeLayout
                            android:id="@+id/btnTransactionHistory"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:text="Transaction History"
                                android:textColor="#E0E0E0"
                                android:textSize="16sp" />

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:src="@drawable/ic_right_arrow"
                                app:tint="#888888" />
                        </RelativeLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="20dp"
                            android:layout_marginBottom="20dp"
                            android:background="#333333" />

                        <!-- Biometric Login Toggle -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:id="@+id/lblBiometrics"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Biometric Login"
                                android:textColor="#E0E0E0"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/lblBiometrics"
                                android:layout_marginTop="4dp"
                                android:text="Use FaceID or Fingerprint"
                                android:textColor="#888888"
                                android:textSize="12sp" />

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/switchBiometrics"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:checked="true"
                                app:useMaterialThemeColors="false"
                                app:thumbTint="#00FFFF"
                                app:trackTint="#1A00FFFF"/>
                        </RelativeLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Logout Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogout"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="32dp"
                    android:text="Log Out"
                    android:textColor="#FF8A8A"
                    android:textSize="16sp"
                    app:backgroundTint="@android:color/transparent"
                    app:icon="@drawable/ic_logout"
                    app:iconGravity="textStart"
                    app:iconTint="#FF8A8A"
                    app:strokeColor="#33FF8A8A"
                    app:strokeWidth="1dp"
                    app:cornerRadius="12dp" />

                <!-- Version Footer -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="UrbanLink v2.4.1-stable • Gqeberha Hub"
                    android:textColor="#666666"
                    android:fontFamily="monospace"
                    android:textSize="10sp" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- 3. FIXED BOTTOM NAVIGATION -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        style="@style/CustomBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#121212"
        app:itemIconTint="@color/nav_item_colors"
        app:itemTextColor="@color/nav_item_colors"
        app:menu="@menu/bottom_nav_menu" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>