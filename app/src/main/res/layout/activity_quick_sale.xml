<?xml version="1.0" encoding="utf-8"?>
    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#121212"
        android:fitsSystemWindows="true"
        tools:context=".QuickSaleActivity">

        <!-- ========================================== -->
        <!-- 1. TOP BAR                                 -->
        <!-- ========================================== -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:paddingHorizontal="20dp"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/btnClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="close"
                android:textColor="#A0A0A0"
                android:textSize="18sp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/txtScreenTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cash Sale"
                android:textColor="#00E5FF"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ========================================== -->
        <!-- 2. ROUTE INFO                              -->
        <!-- ========================================== -->
        <LinearLayout
            android:id="@+id/routeInfoLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:background="#1A1A1A"
            app:layout_constraintTop_toBottomOf="@id/topBar">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_route"
                app:tint="#00E5FF" />

            <TextView
                android:id="@+id/txtRouteName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Route 1: Greenacres to Central"
                android:textColor="#A0A0A0"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- ========================================== -->
        <!-- 3. BASE FARE CARD                          -->
        <!-- ========================================== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/baseFareCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="#1A1A1A"
            app:cardCornerRadius="12dp"
            app:strokeColor="#333333"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/routeInfoLayout">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <ImageView
                    android:id="@+id/icCash"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_circle_dark"
                    android:padding="6dp"
                    android:src="@android:drawable/ic_menu_myplaces"
                    app:tint="#A0A0A0"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/icCash"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="STANDARD BASE FARE"
                        android:textColor="#A0A0A0"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:id="@+id/txtBaseFare"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="R15.00"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp" />
                </LinearLayout>

                <!-- Valid Status Pill -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_green"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:text="✔ Valid"
                    android:textColor="#121212"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ========================================== -->
        <!-- 4. QUANTITY SELECTOR CARD                  -->
        <!-- ========================================== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/quantityCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#1A1A1A"
            app:cardCornerRadius="12dp"
            app:strokeColor="#333333"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/baseFareCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TICKET QUANTITY"
                    android:textColor="#A0A0A0"
                    android:textSize="12sp"
                    android:letterSpacing="0.1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="20dp">

                    <!-- Minus Button -->
                    <ImageView
                        android:id="@+id/btnMinus"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_circle_dark"
                        android:padding="16dp"
                        android:src="@android:drawable/ic_media_pause"
                        app:tint="#888888"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/txtQuantity"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="2"
                        android:textAlignment="center"
                        android:textColor="#FFFFFF"
                        android:textSize="48sp"
                        android:textStyle="bold" />

                    <!-- Plus Button (Cyan) -->
                    <ImageView
                        android:id="@+id/btnPlus"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_circle_cyan"
                        android:padding="16dp"
                        android:src="@android:drawable/ic_input_add"
                        app:tint="#121212"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ========================================== -->
        <!-- 5. AMOUNT DUE CARD                         -->
        <!-- ========================================== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/amountCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#1A1A1A"
            app:cardCornerRadius="12dp"
            app:strokeColor="#1A00E5FF"
            app:strokeWidth="2dp"
            app:layout_constraintTop_toBottomOf="@id/quantityCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AMOUNT DUE"
                    android:textColor="#A0A0A0"
                    android:textSize="12sp"
                    android:letterSpacing="0.1" />

                <!-- The glowing text effect! -->
                <TextView
                    android:id="@+id/txtTotalAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="R30.00"
                    android:textColor="#00E5FF"
                    android:textSize="48sp"
                    android:textStyle="bold"
                    android:shadowColor="#8800E5FF"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="24" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ========================================== -->
        <!-- 6. NEW: NFC TAP TO PAY ZONE                -->
        <!-- ========================================== -->
        <LinearLayout
            android:id="@+id/nfcTapZone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toTopOf="@id/btnConfirmSale"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_contactless"
                app:tint="#A0A0A0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tap Card or Device to Pay"
                android:textColor="#888888"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- ========================================== -->
        <!-- 7. CONFIRM BUTTON                          -->
        <!-- ========================================== -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmSale"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="24dp"
            android:text="Confirm &amp; Issue Ticket"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#00E5FF"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_receipt"
            app:iconGravity="textStart"
            app:iconTint="#000000"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>