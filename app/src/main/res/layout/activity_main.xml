<?xml version="1.0" encoding="utf-8"?>
    <RelativeLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:fitsSystemWindows="true"
        tools:context=".MainActivity">

        <!-- ========================================== -->
        <!-- THE SMART LAYOUT (Map & Bottom Sheet)      -->
        <!-- Restricted to sit ABOVE the bottom nav     -->
        <!-- ========================================== -->
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/bottomNav">

            <!-- 1. FIXED TOP HEADER -->
            <com.google.android.material.appbar.AppBarLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                app:elevation="0dp">

                <include
                    android:id="@+id/topHeader"
                    layout="@layout/layout_top_header"
                    android:layout_width="match_parent"
                    android:layout_height="64dp" />
            </com.google.android.material.appbar.AppBarLayout>

            <!-- 2. THE MAP BACKGROUND -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_behavior="@string/appbar_scrolling_view_behavior">

                <androidx.fragment.app.FragmentContainerView
                    android:id="@+id/mapFragment"
                    android:name="com.google.android.gms.maps.SupportMapFragment"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Network Cached"
                    android:textColor="#E0E0E0"
                    app:chipBackgroundColor="#CC121212"
                    app:chipIcon="@drawable/ic_wifi"
                    app:chipIconTint="#00FF7F"
                    app:chipStrokeWidth="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 3. THE EXPANDABLE BOTTOM SHEET -->
            <!-- Padding removed since it no longer hides behind the nav bar -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/bottomSheet"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_bottom_sheet_rounded"
                android:elevation="16dp"
                app:behavior_hideable="false"
                app:behavior_peekHeight="80dp"
                app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="40dp">

                    <!-- Drag Handle -->
                    <View
                        android:id="@+id/dragHandle"
                        android:layout_width="40dp"
                        android:layout_height="4dp"
                        android:layout_marginTop="12dp"
                        android:background="#424242"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Greeting -->
                    <TextView
                        android:id="@+id/greetingTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"
                        android:text="Hello, Commuter"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/dragHandle" />

                    <!-- PLAN A JOURNEY CARD -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardPlanJourney"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="16dp"
                        app:cardBackgroundColor="#151515"
                        app:cardCornerRadius="16dp"
                        app:strokeColor="#2C2C2C"
                        app:strokeWidth="1dp"
                        app:layout_constraintTop_toBottomOf="@id/greetingTitle">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="20dp">

                            <ImageView
                                android:id="@+id/iconJourney"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_circle_dark"
                                android:padding="6dp"
                                android:src="@drawable/ic_route"
                                app:tint="#00E5FF"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:id="@+id/txtPlanTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:text="Plan a Journey"
                                android:textColor="#FFFFFF"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                app:layout_constraintBottom_toBottomOf="@id/iconJourney"
                                app:layout_constraintStart_toEndOf="@id/iconJourney"
                                app:layout_constraintTop_toTopOf="@id/iconJourney" />

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/inputsContainer"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="20dp"
                                app:layout_constraintTop_toBottomOf="@id/iconJourney">

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/inputLayoutLeaving"
                                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="Current Location"
                                    app:boxBackgroundColor="#1A1A1A"
                                    app:boxCornerRadiusBottomEnd="12dp"
                                    app:boxCornerRadiusBottomStart="12dp"
                                    app:boxCornerRadiusTopEnd="12dp"
                                    app:boxCornerRadiusTopStart="12dp"
                                    app:boxStrokeColor="#333333"
                                    app:hintTextColor="#9E9E9E"
                                    app:startIconDrawable="@drawable/ic_my_location"
                                    app:startIconTint="#9E9E9E"
                                    app:layout_constraintTop_toTopOf="parent">

                                    <AutoCompleteTextView
                                        android:id="@+id/etStartLocation"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:textColor="#FFFFFF"
                                        android:completionThreshold="2"
                                        android:inputType="textNoSuggestions" />
                                </com.google.android.material.textfield.TextInputLayout>

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/inputLayoutGoing"
                                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:hint="Going to..."
                                    app:boxBackgroundColor="#1A1A1A"
                                    app:boxCornerRadiusBottomEnd="12dp"
                                    app:boxCornerRadiusBottomStart="12dp"
                                    app:boxCornerRadiusTopEnd="12dp"
                                    app:boxCornerRadiusTopStart="12dp"
                                    app:boxStrokeColor="#333333"
                                    app:hintTextColor="#9E9E9E"
                                    app:startIconDrawable="@drawable/ic_location_on"
                                    app:startIconTint="#00E5FF"
                                    app:layout_constraintTop_toBottomOf="@id/inputLayoutLeaving">

                                    <AutoCompleteTextView
                                        android:id="@+id/etEndLocation"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:textColor="#FFFFFF"
                                        android:completionThreshold="2"
                                        android:inputType="textNoSuggestions" />
                                </com.google.android.material.textfield.TextInputLayout>

                                <View
                                    android:layout_width="1dp"
                                    android:layout_height="20dp"
                                    android:layout_marginStart="24dp"
                                    android:background="#333333"
                                    app:layout_constraintBottom_toTopOf="@id/inputLayoutGoing"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@id/inputLayoutLeaving" />

                            </androidx.constraintlayout.widget.ConstraintLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/findRouteBtn"
                                android:layout_width="match_parent"
                                android:layout_height="60dp"
                                android:layout_marginTop="20dp"
                                android:text="Find Route"
                                android:textAllCaps="false"
                                android:textColor="#000000"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                app:backgroundTint="#00E5FF"
                                app:cornerRadius="30dp"
                                app:icon="@drawable/ic_arrow_forward"
                                app:iconGravity="textEnd"
                                app:iconTint="#000000"
                                app:layout_constraintTop_toBottomOf="@id/inputsContainer" />

                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- SCHEDULE CARDS -->
                    <LinearLayout
                        android:id="@+id/scheduleContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="16dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal"
                        app:layout_constraintTop_toBottomOf="@id/cardPlanJourney">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardBusSchedules"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardBackgroundColor="#151515"
                            app:cardCornerRadius="16dp"
                            app:strokeColor="#2C2C2C"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="24dp">

                                <ImageView
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:background="@drawable/bg_circle_dark"
                                    android:padding="12dp"
                                    android:src="@drawable/ic_bus"
                                    app:tint="#00E5FF" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:text="Bus\nSchedules"
                                    android:textAlignment="center"
                                    android:textColor="#FFFFFF"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardRailSchedules"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardBackgroundColor="#151515"
                            app:cardCornerRadius="16dp"
                            app:strokeColor="#2C2C2C"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="24dp">

                                <ImageView
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:background="@drawable/bg_circle_dark"
                                    android:padding="12dp"
                                    android:src="@drawable/ic_train"
                                    app:tint="#00E5FF" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:text="Train\nSchedules"
                                    android:textAlignment="center"
                                    android:textColor="#FFFFFF"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <!-- RECENT DESTINATIONS -->
                    <TextView
                        android:id="@+id/txtRecent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="32dp"
                        android:text="Recent Destinations"
                        android:textColor="#9E9E9E"
                        android:textSize="14sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/scheduleContainer" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:layout_constraintTop_toBottomOf="@id/txtRecent">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_circle_dark"
                            android:padding="10dp"
                            android:src="@drawable/ic_schedule"
                            app:tint="#9E9E9E" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Central Station"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="15 min via Subway"
                                android:textColor="#9E9E9E"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- Floating Barcode Button -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                app:backgroundTint="#00FF7F"
                app:srcCompat="@android:drawable/ic_menu_camera" />

        </androidx.coordinatorlayout.widget.CoordinatorLayout>

        <!-- ========================================== -->
        <!-- LOCKED BOTTOM NAVIGATION                   -->
        <!-- Forced to the absolute bottom              -->
        <!-- ========================================== -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            style="@style/CustomBottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="#121212"
            app:elevation="24dp"
            app:itemIconTint="@color/nav_item_colors"
            app:itemTextColor="@color/nav_item_colors"
            app:menu="@menu/bottom_nav_menu" />

    </RelativeLayout>