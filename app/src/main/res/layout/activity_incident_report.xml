<?xml version="1.0" encoding="utf-8"?>
    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#121212"
        android:fitsSystemWindows="true"
        tools:context=".IncidentReportActivity">

        <!-- ========================================== -->
        <!-- 1. TOP APP BAR                             -->
        <!-- ========================================== -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp"
                android:src="@android:drawable/ic_menu_revert"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="#E0E0E0" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/btnBack"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Report Incident"
                    android:textColor="#00E5FF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtRouteContext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bus ALGOA-042 • Route 1"
                    android:textColor="#A0A0A0"
                    android:textSize="12sp" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:id="@+id/dividerTop"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2A2A2A"
            app:layout_constraintTop_toBottomOf="@id/topBar" />

        <!-- ========================================== -->
        <!-- SCROLLABLE CONTENT                         -->
        <!-- ========================================== -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingBottom="100dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dividerTop">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- ========================================== -->
                <!-- 2. EMERGENCY SOS CARD                      -->
                <!-- ========================================== -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardEmergency"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#1A1A1A"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="#4DFF4C4C"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="20dp"
                        android:paddingTop="20dp"
                        android:paddingBottom="16dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEmergencySOS"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:text="EMERGENCY SOS"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1"
                            app:backgroundTint="#FF4C4C"
                            app:cornerRadius="8dp"
                            app:icon="@android:drawable/ic_dialog_alert"
                            app:iconGravity="textStart"
                            app:iconPadding="12dp"
                            app:iconTint="#FFFFFF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Instantly sends GPS coordinates to depot security."
                            android:textColor="#FF9E9E"
                            android:textSize="12sp"
                            android:textAlignment="center" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ========================================== -->
                <!-- 3. ROUTINE ISSUE CARD                      -->
                <!-- ========================================== -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="#1A1A1A"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="#2A2A2A"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Log Routine Issue"
                            android:textColor="#E0E0E0"
                            android:textSize="18sp"
                            android:layout_marginBottom="16dp" />

                        <!-- ChipGroup allows auto-wrapping to the next line -->
                        <!-- ChipGroup allows auto-wrapping to the next line -->
                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupIssues"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:chipSpacingHorizontal="8dp"
                            app:chipSpacingVertical="8dp"
                            app:singleSelection="true"
                            app:selectionRequired="true">

                            <com.google.android.material.chip.Chip
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:id="@+id/chipEngine"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Engine Trouble"
                                android:checkable="true"
                                android:checked="true" />

                            <com.google.android.material.chip.Chip
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:id="@+id/chipTire"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Flat Tire"
                                android:checkable="true" />

                            <com.google.android.material.chip.Chip
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:id="@+id/chipScanner"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Scanner Offline"
                                android:checkable="true" />

                            <com.google.android.material.chip.Chip
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:id="@+id/chipMedical"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Medical Event"
                                android:checkable="true" />

                            <com.google.android.material.chip.Chip
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:id="@+id/chipDispute"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Passenger Dispute"
                                android:checkable="true" />

                            <com.google.android.material.chip.Chip
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:id="@+id/chipDelay"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Delay"
                                android:checkable="true" />

                            <com.google.android.material.chip.Chip
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:id="@+id/chipOther"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Other"
                                android:checkable="true" />

                        </com.google.android.material.chip.ChipGroup>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ========================================== -->
                <!-- 4. DETAILS CARD                            -->
                <!-- ========================================== -->
                <!-- DETAILS CARD -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#1A2222"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="#333333"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="Details"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp" />

                        <!-- Text Input with Mic Icon -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:boxBackgroundColor="#121212"
                            app:boxStrokeColor="#333333"
                            app:endIconDrawable="@android:drawable/ic_btn_speak_now"
                            app:endIconMode="custom"
                            app:endIconTint="#00E5FF"
                            app:hintEnabled="false">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/inputDetails"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="top|start"
                                android:hint="Add brief details (optional)..."
                                android:lines="4"
                                android:textColor="#FFFFFF"
                                android:textColorHint="#666666" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ========================================== -->
        <!-- 5. SUBMIT BUTTON                           -->
        <!-- ========================================== -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitReport"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            android:text="Submit Report"
            android:textColor="#121212"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="#00FF7F"
            app:cornerRadius="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>