<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:background="#0A0B10">

    <!-- Bus Tag -->
    <LinearLayout
        android:id="@+id/busTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:background="@drawable/bg_pill"
        android:backgroundTint="#1A1B22"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_pill" android:backgroundTint="#00FF7F" />
        <TextView android:id="@+id/txtHeaderBusTag" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="BUS #ALGOA-042" android:textColor="#00E5FF" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>

    <!-- Route Info -->
    <LinearLayout
        android:id="@+id/routeInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/busTag"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/txtHeaderRouteName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.1" android:text="ROUTE 1 EXPRESS · " android:textColor="#008899" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/txtHeaderRouteDirection" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Downtown → Summerstrand" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
    </LinearLayout>

