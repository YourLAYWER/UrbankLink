<!--    </LinearLayout>-->

    <!-- Shift Hours -->
    <LinearLayout
        android:id="@+id/shiftCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_pill"
        android:backgroundTint="#1A1B22"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnSOS"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@android:drawable/ic_menu_recent_history" app:tint="#00E5FF" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SHIFT HOURS" android:textColor="#888888" android:textSize="8sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="02:28 h" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- SOS Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSOS"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:text="SOS"
        android:textColor="#FFFFFF"
        app:backgroundTint="#FF4C4C"
        app:cornerRadius="100dp"
        app:icon="@android:drawable/ic_dialog_alert"
        app:iconTint="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>