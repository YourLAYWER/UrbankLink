<?xml version="1.0" encoding="utf-8"?>
    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#121212"
        android:fitsSystemWindows="true"
        tools:context=".ScannerActivity">

        <!-- ========================================== -->
        <!-- 1. TOP STATUS BAR                          -->
        <!-- ========================================== -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingHorizontal="16dp"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/txtRouteInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Route 1 • Bus ALGOA-042"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/btnEndShift"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_lock_power_off"
                    app:tint="#A0A0A0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="End Shift"
                    android:textColor="#A0A0A0"
                    android:textSize="14sp" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:id="@+id/topDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            app:layout_constraintTop_toBottomOf="@id/topBar" />

        <!-- ========================================== -->
        <!-- 2. CAMERA SCANNER AREA                     -->
        <!-- ========================================== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/scannerContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="16dp"
            app:cardBackgroundColor="#000000"
            app:cardCornerRadius="12dp"
            app:strokeColor="#333333"
            app:strokeWidth="1dp"
            app:layout_constraintBottom_toTopOf="@id/capacityCard"
            app:layout_constraintTop_toBottomOf="@id/topDivider">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- CameraX Preview View (Ready for backend logic) -->
<!--                <androidx.camera.view.PreviewView-->
<!--                    android:id="@+id/viewFinder"-->
<!--                    android:layout_width="match_parent"-->
<!--                    android:layout_height="match_parent" />-->

                <!-- Cyan Viewfinder Overlay -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="32dp"
                    android:src="@drawable/bg_scanner_brackets" />

                <!-- Dynamic Result Pill -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/pillScanResult"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="24dp"
                    app:cardBackgroundColor="#00FF7F"
                    app:cardCornerRadius="24dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="12dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/bg_circle_dark"
                            android:backgroundTint="#00CC66"
                            android:padding="4dp"
                            android:src="@android:drawable/ic_input_add"
                            app:tint="#121212" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="VALID TICKET -\nR15.00"
                            android:textColor="#121212"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ========================================== -->
        <!-- 3. CAPACITY TRACKER CARD                   -->
        <!-- ========================================== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/capacityCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#1A2222"
            app:cardCornerRadius="12dp"
            app:strokeColor="#333333"
            app:strokeWidth="1dp"
            app:layout_constraintBottom_toTopOf="@id/toggleCard">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingVertical="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:text="CAPACITY"
                    android:textColor="#A0A0A0"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/txtCurrentCapacity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="45"
                        android:textColor="#FFFFFF"
                        android:textSize="48sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtMaxCapacity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="/ 60"
                        android:textColor="#00E5FF"
                        android:textSize="24sp" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ========================================== -->
        <!-- 4. MARK FULL TOGGLE CARD                   -->
        <!-- ========================================== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/toggleCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#1E1E1E"
            app:cardCornerRadius="12dp"
            app:strokeColor="#333333"
            app:strokeWidth="1dp"
            app:layout_constraintBottom_toTopOf="@id/btnCashSale">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="Mark Bus as Full"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchBusFull"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    app:thumbTint="#E0E0E0"
                    app:trackTint="#444444" />
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ========================================== -->
        <!-- 5. CASH SALE ACTION BUTTON                 -->
        <!-- ========================================== -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCashSale"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            android:text="CASH TICKET SALE"
            android:textColor="#00E5FF"
            android:textSize="18sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:icon="@android:drawable/ic_menu_agenda"
            app:iconGravity="textStart"
            app:iconTint="#00E5FF"
            app:strokeColor="#00E5FF"
            app:strokeWidth="2dp"
            app:layout_constraintBottom_toTopOf="@id/bottomNav" />

        <!-- ========================================== -->
        <!-- 6. BOTTOM NAVIGATION                       -->
        <!-- ========================================== -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#121212"
            app:itemIconTint="@color/nav_item_colors"
            app:itemTextColor="@color/nav_item_colors"
            app:layout_constraintBottom_toBottomOf="parent"
            app:menu="@menu/driver_bottom_nav_menu" />

    </androidx.constraintlayout.widget.ConstraintLayout>