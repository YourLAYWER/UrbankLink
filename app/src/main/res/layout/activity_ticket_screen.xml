<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainTicket"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fitsSystemWindows="true"
    tools:context=".commuter.TicketScreen">

    <!-- ========================================== -->
    <!-- THE SMART LAYOUT (Map & Bottom Sheet)      -->
    <!-- Restricted to sit ABOVE the bottom nav     -->
    <!-- ========================================== -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNav">

        <!-- 1. FIXED TOP HEADER -->
        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:elevation="0dp">

            <include
                android:id="@+id/topHeader"
                layout="@layout/layout_top_header"
                android:layout_width="match_parent"
                android:layout_height="64dp" />
        </com.google.android.material.appbar.AppBarLayout>

        <!-- 2. THE MAP BACKGROUND -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <!-- Google Maps Fragment filling the background -->
            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/mapFragment"
                android:name="com.google.android.gms.maps.SupportMapFragment"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 3. THE EXPANDABLE BOTTOM SHEET -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/ticketBottomSheet"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_bottom_sheet_rounded"
            android:elevation="16dp"
            app:behavior_hideable="false"
            app:behavior_peekHeight="350dp"
            app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="24dp"
                android:paddingBottom="40dp">

                <!-- Drag Handle -->
                <View
                    android:id="@+id/dragHandle"
                    android:layout_width="40dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="12dp"
                    android:background="#424242"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Live Updates Indicator -->
                <ImageView
                    android:id="@+id/dotLive"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginTop="24dp"
                    android:src="@android:drawable/presence_online"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/dragHandle"
                    app:tint="#00FF7F" />

                <TextView
                    android:id="@+id/txtLiveUpdates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:letterSpacing="0.1"
                    android:text="LIVE UPDATES"
                    android:textColor="#00FF7F"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/dotLive"
                    app:layout_constraintStart_toEndOf="@id/dotLive"
                    app:layout_constraintTop_toTopOf="@id/dotLive" />

                <!-- Bus Badge -->
                <TextView
                    android:id="@+id/badgeBus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#1A00FFFF"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="🚍 TICKET"
                    android:textColor="#00FFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/txtLiveUpdates"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/txtLiveUpdates" />


                <!-- Live Update Message Bubble -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/liveUpdateBubble"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="48dp"
                    app:cardBackgroundColor="#1A2421"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="#2C3A35"
                    app:strokeWidth="1dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/txtLiveUpdates">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Your exact ID is preserved here so Java keeps working perfectly -->
                    <TextView
                        android:id="@+id/txtArrivalTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Bus is on Route."
                        android:textColor="#E0FFFF"
                        android:textSize="15sp"
                        android:lineSpacingExtra="4dp" /> <!-- Adds breathing room between lines -->

                    <!-- WhatsApp-style timestamp footer -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="System Alert"
                            android:textColor="#757575"
                            android:textSize="11sp"
                            android:layout_marginEnd="4dp"/>

                        <!-- Standard Android double-check/info icon mimicking read receipts -->
                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@android:drawable/presence_online"
                            app:tint="#00FF7F" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>





                <!-- Current Leg Card -->
                <!-- Current Leg Card (Modernized) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/legCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    app:cardBackgroundColor="#151515"
                    app:cardCornerRadius="16dp"
                    app:layout_constraintTop_toBottomOf="@id/liveUpdateBubble"
                    app:strokeColor="#2C2C2C"
                    app:strokeWidth="1dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp">

                        <!-- 1. Route Section -->
                        <ImageView
                            android:id="@+id/icStart"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_circle_dark"
                            android:padding="8dp"
                            android:src="@drawable/ic_route"
                            app:tint="#00E5FF"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/lblCurrentLeg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:letterSpacing="0.1"
                            android:text="JOURNEY ROUTE"
                            android:textColor="#757575"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toEndOf="@id/icStart"
                            app:layout_constraintTop_toTopOf="@id/icStart" />

                        <TextView
                            android:id="@+id/txtCurrentLeg"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Loading Route..."
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="@id/lblCurrentLeg"
                            app:layout_constraintTop_toBottomOf="@id/lblCurrentLeg" />

                        <!-- Horizontal Divider (Reusing timelineLine ID so Java doesn't crash) -->
                        <View
                            android:id="@+id/timelineLine"
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_marginTop="20dp"
                            android:background="#2C2C2C"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/txtCurrentLeg" />

                        <!-- 2. Arrival Section -->
                        <ImageView
                            android:id="@+id/icEnd"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginTop="20dp"
                            android:background="@drawable/bg_circle_dark"
                            android:padding="8dp"
                            android:src="@drawable/ic_schedule"
                            app:tint="#00FF7F"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/timelineLine" />

                        <TextView
                            android:id="@+id/lblEstimated"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:letterSpacing="0.1"
                            android:text="ESTIMATED ARRIVAL"
                            android:textColor="#757575"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toEndOf="@id/icEnd"
                            app:layout_constraintTop_toTopOf="@id/icEnd" />

                        <TextView
                            android:id="@+id/txtEstimated"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="--:--"
                            android:textColor="#00FF7F"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="@id/lblEstimated"
                            app:layout_constraintTop_toBottomOf="@id/lblEstimated" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- QR Code Container -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/qrCodeCard"
                    android:layout_width="260dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:layout_marginBottom="32dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/legCard">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">

                        <!-- Dynamic Status Badge -->
                        <TextView
                            android:id="@+id/txtTicketStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#1A00FF7F"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="6dp"
                            android:text="ACTIVE"
                            android:textColor="#00FF7F"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1"/>

                        <ImageView
                            android:id="@+id/ic_qr"
                            android:layout_width="200dp"
                            android:layout_height="200dp"
                            android:layout_marginTop="16dp"
                            android:scaleType="fitCenter"
                            android:src="@android:drawable/ic_dialog_info" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- ========================================== -->
    <!-- LOCKED BOTTOM NAVIGATION                   -->
    <!-- Forced to the absolute bottom              -->
    <!-- ========================================== -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        style="@style/CustomBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#121212"
        app:itemIconTint="@color/nav_item_colors"
        app:itemTextColor="@color/nav_item_colors"
        app:menu="@menu/bottom_nav_menu" />

</RelativeLayout>