<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:backgroundTint="#151515">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#424242"
        android:layout_marginBottom="16dp"/>

    <!-- Transport Type (e.g., Bus or Train) -->
    <TextView
        android:id="@+id/sheetTransportType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bus Service"
        android:textColor="#9E9E9E"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textAllCaps="true"/>

    <!-- Route Name -->
    <TextView
        android:id="@+id/sheetRouteName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Route Name"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="24dp"/>

    <!-- Call to Action Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/sheetActionBtn"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="View Route Details"
        android:textColor="#000000"
        android:textStyle="bold"
        android:textAllCaps="false"
        app:backgroundTint="#00E5FF"
        app:cornerRadius="30dp"
        android:textSize="16sp"/>

</LinearLayout>