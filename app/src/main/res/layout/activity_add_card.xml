<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    tools:context=".commuter.AddCardActivity">

    <!-- Reused Top Header -->
    <include
        android:id="@+id/topHeader"
        layout="@layout/layout_top_header"
        android:layout_width="match_parent"
        android:layout_height="64dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Live Card Preview -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Card Preview"
                android:textColor="#888888"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Embeds the card UI you previously built -->
            <include
                android:id="@+id/layoutCardPreview"
                layout="@layout/item_carousel_card"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginBottom="32dp" />

            <!-- Input Form -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="Cardholder Name"
                app:boxBackgroundColor="#1E1E1E"
                app:boxStrokeColor="#00FFFF"
                app:hintTextColor="#00FFFF">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputCardName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:textAllCaps="true"
                    android:textColor="#FFFFFF" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="Card Number"
                app:boxBackgroundColor="#1E1E1E"
                app:boxStrokeColor="#00FFFF"
                app:hintTextColor="#00FFFF">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputCardNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"
                    android:maxLength="19"
                    android:textColor="#FFFFFF" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp"
                android:baselineAligned="false">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:hint="Expiry (MM/YY)"
                    app:boxBackgroundColor="#1E1E1E"
                    app:boxStrokeColor="#00FFFF"
                    app:hintTextColor="#00FFFF">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputExpiry"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="datetime"
                        android:maxLength="5"
                        android:textColor="#FFFFFF" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:hint="CVV"
                    app:boxBackgroundColor="#1E1E1E"
                    app:boxStrokeColor="#00FFFF"
                    app:hintTextColor="#00FFFF">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputCvv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberPassword"
                        android:maxLength="3"
                        android:textColor="#FFFFFF" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchDefault"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:text="Set as Default Payment Method"
                android:textColor="#E0E0E0"
                android:textSize="14sp"
                app:useMaterialThemeColors="false"
                app:thumbTint="#00FFFF"
                app:trackTint="#1A00FFFF"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveCard"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Save Card"
                android:textColor="#121212"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="#00FFFF"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>