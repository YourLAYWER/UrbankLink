<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="100dp"
    android:layout_height="match_parent"
    android:background="#12131A"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingVertical="16dp">

    <!-- SCAN TAB -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/navTabScan"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="#1A1B22"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
            <ImageView android:id="@+id/icScan" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_scan" app:tint="#A0A0A0" />
            <TextView android:id="@+id/txtScan" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="SCAN" android:textColor="#A0A0A0" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- CASH TAB -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/navTabCash"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="#1A1B22"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
            <ImageView android:id="@+id/icCash" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_cash" app:tint="#A0A0A0" />
            <TextView android:id="@+id/txtCash" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="CASH" android:textColor="#A0A0A0" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- STOPS TAB -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/navTabStops"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="#1A1B22"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
            <ImageView android:id="@+id/icStops" android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_menu_directions" app:tint="#A0A0A0" />
            <TextView android:id="@+id/txtStops" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="STOPS" android:textColor="#A0A0A0" android:textSize="10sp" android:textStyle="bold" />
            <TextView android:id="@+id/txtStopsSub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="IN ROUTE" android:textColor="#A0A0A0" android:textSize="8sp" android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- SHIFT TAB -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/navTabShift"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="#1A1B22"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
            <ImageView android:id="@+id/icShift" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_time" app:tint="#A0A0A0" />
            <TextView android:id="@+id/txtShift" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="SHIFT" android:textColor="#A0A0A0" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- REPORT TAB -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/navTabReport"
        android:layout_width="72dp"
        android:layout_height="72dp"
        app:cardBackgroundColor="#1A1B22"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
            <ImageView android:id="@+id/icReport" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_alert" app:tint="#A0A0A0" />
            <TextView android:id="@+id/txtReport" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="REPORT" android:textColor="#A0A0A0" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <!-- PROFILE TAB -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/navTabProfile"
        android:layout_width="72dp"
        android:layout_height="72dp"
        app:cardBackgroundColor="#1A1B22"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
            <ImageView android:id="@+id/icProfile" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_profile" app:tint="#A0A0A0" />
            <TextView android:id="@+id/txtProfile" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="PROFILE" android:textColor="#A0A0A0" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>